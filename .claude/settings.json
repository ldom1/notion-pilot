{
  "mcpServers": {
    "code-index": {
      "command": "uvx",
      "args": [
        "code-index-mcp",
        "--project-path",
        "/home/lgiron/lab/notion-pilot"
      ]
    },
    "qmd": {
      "command": "qmd",
      "args": [
        "mcp"
      ],
      "env": {
        "INDEX_PATH": "/home/lgiron/vault-qmd/brain.db"
      }
    },
    "artelys-crm": {
      "command": "sh",
      "args": [
        "-c",
        "cd /home/lgiron/lab/notion-pilot && infisical run --env dev --path / -- uv --directory vendor/notion-pilot-powers run notion-pilot-powers --with-external"
      ]
    }
  },
  "worktree": {
    "baseRef": "head"
  }
}
