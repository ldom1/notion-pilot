# --- Secrets & local-only ---
# Never commit credentials or machine-specific deploy scripts.
.env
.env.bootstrap
.env.*
!.env.example
!.env.bootstrap.example
deploy.sh
PLAN.md
# Local-dev-only host port mapping — Coolify routes by domain, not a hardcoded host port
# (coolify-hp-elite-server-sop.md, "reserved host ports" rule)
docker-compose.override.yml

# --- Python bytecode & packaging ---
__pycache__/
*.py[cod]
*$py.class
*.so
dist/
build/
*.egg
*.egg-info/
.eggs/
MANIFEST

# --- Virtualenvs ---
.venv/
venv/
env/
.python-version

# --- Test & coverage artifacts ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.tox/
.nox/
.hypothesis/

# --- Type-checker / linter caches ---
.mypy_cache/
.ruff_cache/
.pylint_cache/
.pyre/
.pytype/

# --- Jupyter / notebooks ---
.ipynb_checkpoints/
# local scratch notebook — keep uncommitted
test.ipynb

# --- IDE / editor state ---
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# --- Generated files ---
# Written by hatch-vcs at build time from the current git tag.
telegram_to_notion/_version.py

# --- Project-specific ---
# faster-whisper model weights if dropped in a local models/ dir
models/
*.onnx
# Ad-hoc debug logs
*.log
logs/

# --- Data files ---
data/

# --- Claude ---
.claude/worktrees/
.superpowers/
# Per-workspace data (DB pointers, workflows — not committed)
web/workspaces/

# Frontend build
web/dist/
web/frontend/node_modules/

# Playwright: minted session state holds a real Notion token
web/frontend/e2e/.auth/
web/frontend/test-results/
web/frontend/playwright-report/
web/frontend/blob-report/

# Real CRM export used only as design reference — never commit (contains client names)
docs/notion_export/

# --- Promotional videos (promotion/video) ---
# Sources are committed: the compositions, their BRIEF.md, the brand profile and
# _shared/ (design system + localised fonts). Everything below is generated —
# `./hyperframes/sync-shared.sh` recreates each project's assets/, and
# `hyperframes render` recreates out.mp4. The delivered MP4s live in
# web/frontend/public/film/ and ARE committed, since the app serves them.
promotion/video/node_modules/
promotion/video/hyperframes/*/assets/
promotion/video/hyperframes/*/out.mp4
promotion/video/hyperframes/*/snapshots/

# --- HyperFrames skill pack (vendored by `npx skills add heygen-com/hyperframes`) ---
# ~20 upstream skills installed into .agents/skills/ and symlinked into skills/
# and .claude/skills/. skills-lock.json pins them, so reinstall rather than
# commit a vendored copy. This project's own skills stay tracked.
.agents/*
!.agents/product-marketing.md
skills/*
.claude/skills/*
!.claude/skills/artelys-crm/
!.claude/skills/artelys-crm/**